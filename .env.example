# ARK API key used by the BytePlus Ark SDK for character, video, and world-building generation. Required for app runtime.
ARK_API_KEY=

# BytePlus access key used for TOS uploads and asset creation. Required when uploading images/videos to TOS.
BYTEPLUS_AK=

# BytePlus secret key paired with BYTEPLUS_AK. Required when uploading images/videos to TOS.
BYTEPLUS_SK=

# TOS bucket name that stores uploaded media assets. Required for any asset upload workflow.
TOS_BUCKET_NAME=

# TOS region for the target bucket. Required for TOS client configuration; defaults to ap-southeast-1 if omitted in code.
TOS_REGION=

# Ark project name used when creating remote media assets. Required for asset registration workflows.
ARK_PROJECT=

# Ark model endpoint used when creating remote media assets. Required for asset registration workflows.
ARK_MODEL_ENDPOINT=

# Seed Audio 1.5 (early access) key. Optional — falls back to ARK_API_KEY when empty.
SEED_AUDIO_API_KEY=

# Seed Audio endpoint/model ID. Optional — defaults to ep-20260921143824-2m8c9.
SEED_AUDIO_MODEL=

# Optional: SEED_AUDIO_BASE_URL (default https://ark.ap-southeast.bytepluses.com), SEED_AUDIO_MAX_CONCURRENCY (default 2).

# BytePlus AI MediaKit key for the Video Enhancer tool. Optional — a separate credential from ARK_API_KEY (AI MediaKit console → Settings).
MEDIAKIT_API_KEY=

# Optional: MEDIAKIT_REGION (default ap-southeast-1).
